(* 1.3. От жизненной задачи к проверенному ответу *)
a = {{2, 1}, {1, 2}};
b = {12, 12};
solution = LinearSolve[a, b];
residual = b - a.solution;
{solution, residual}

(* 1.4. Точная арифметика, округление и обусловленность *)
eps = 1/100000;
a = {{1, 1}, {1, 1 + eps}};
b = {2, 2 + eps};
x0 = LinearSolve[a, b];
x1 = LinearSolve[a, b + {0, eps}];
kappa = Norm[N[a], 2] Norm[Inverse[N[a]], 2];
{x0, x1, kappa}

